class Solution {
    public int countFriendsPairings(int n) {
        int[] dp = new int[n + 1];

        // Initialize with -1
        Arrays.fill(dp, -1);

        return solve(n, dp);
    }

    public int solve(int n, int[] dp) {

        // Base cases
        if (n == 0 || n == 1) {
            return 1;
        }

        // Already calculated
        if (dp[n] != -1) {
            return dp[n];
        }

        // Same recurrence as tabulation
        dp[n] = solve(n - 1, dp) + (n - 1) * solve(n - 2, dp);

        return dp[n];
    }
}
